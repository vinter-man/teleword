# Telegram bot token from @BotFather
BOT_TOKEN=

# Your Telegram user id (ask @userinfobot): receives API key requests, can use /admin
ADMIN_ID=

# Day boundaries for streaks and the /time command
TIMEZONE=UTC

# Base URL shown to users in the /api instructions
API_PUBLIC_URL=http://localhost:8790

# Local runs only; docker-compose.yml sets these itself
# DATABASE_URL=sqlite+aiosqlite:///./data/teleword.db
# REDIS_URL=redis://localhost:6379/0
